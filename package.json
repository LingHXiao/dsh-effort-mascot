{
  "name": "dsh-effort-mascot",
  "version": "1.0.0",
  "type": "module",
  "description": "Reasoning-effort slider for DeepSeek Harness — a dark card with one mascot illustration per level.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*",
    "docs/four-tiers.webp",
    "README.md",
    "README.en.md",
    "docs/cover.webp",
    "docs/cover-en.webp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "reasoning",
    "effort",
    "slider",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LingHXiao/dsh-effort-mascot.git"
  },
  "homepage": "https://github.com/LingHXiao/dsh-effort-mascot#readme",
  "bugs": {
    "url": "https://github.com/LingHXiao/dsh-effort-mascot/issues"
  },
  "author": "LingHXiao"
}
